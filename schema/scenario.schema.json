{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usefullforyouandme.github.io/soccer_theory/schema/scenario.schema.json",
  "title": "戦術アニメーション用シナリオ",
  "description": "8人制サッカー戦術学習アプリのシナリオデータ。座標系: X=0(左タッチライン)〜50(右), Y=0(相手ゴールライン)〜68(自陣ゴールライン)。home は Y=68 側から Y=0 側へ攻撃する。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "category",
    "group",
    "pattern",
    "theme",
    "targetGrade",
    "question",
    "keyPoint",
    "teams",
    "variants"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "kind": {
      "description": "シナリオの種類。match=試合の場面(省略時)、drill=練習メニューの説明(コーンドリブル・2人のパスなど。練習ページに並ぶ)。drill では area・practice が必要で、選手は出てくる人だけでよい",
      "enum": [
        "match",
        "drill"
      ]
    },
    "id": {
      "description": "ファイル名と一致させる(kebab-case)",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "description": "テーマ名(同じテーマの別パターンは同じタイトルにする)",
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "questionTitle": {
      "description": "子ども向けの疑問形のタイトル(答えを書かない)。一覧と、問いかけ中の再生画面に出す。同じテーマのパターンは同じ値。例: 取られた時、近くの人は?",
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "category": {
      "description": "種類。試合の場面は build=ボールを前へ運ぶ、attack=ゴールをねらう、defend=ボールを取る・守る、transition=切りかえ、restart=リスタート・キーパー。練習メニュー(kind: drill)は dribble=ドリブル、pass=パス",
      "enum": [
        "build",
        "attack",
        "defend",
        "transition",
        "restart",
        "dribble",
        "pass"
      ]
    },
    "group": {
      "description": "テーマのID(同じテーマの別パターンは同じ値にする)。例: counter-press",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "keyword": {
      "description": "ずかん全体の合言葉。look=見る、move=動いて受ける、goal=ゴールへ向かう、switch=すぐ切りかえる、protect=ゴールを守る。同じテーマは同じ値",
      "enum": [
        "look",
        "move",
        "goal",
        "switch",
        "protect"
      ]
    },
    "courseOrder": {
      "description": "おすすめの順番(1〜)。テーマごとに1つの番号。同じテーマは同じ値",
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "pattern": {
      "description": "パターン名(ボールの位置・守備の状況の違い)。一覧と画面の見出しに表示。例: サイドで取られた時",
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "theme": {
      "description": "指導者向けのテーマ説明(漢字可)",
      "type": "string",
      "minLength": 1
    },
    "coachNote": {
      "description": "指導者向けの補足(任意・漢字可)",
      "type": "string"
    },
    "counterpart": {
      "description": "同じ場面を反対側(攻める側/守る側、取った側/取られた側)から見たシナリオへのリンク。相手側のシナリオからも、このシナリオを指す(おたがいに指し合う)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "description": "反対側のシナリオの id",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "label": {
          "description": "ボタンの文字(例: 守る側から見る)",
          "type": "string",
          "minLength": 1,
          "maxLength": 12
        }
      }
    },
    "next": {
      "description": "つづきの場面のシナリオ(例: ゴール前へ入らないミスで取られた → 取られたらすぐ取り返す)。結末の後にボタンで出す",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "label": {
          "description": "ボタンの文字(例: 取られた後を見る)",
          "type": "string",
          "minLength": 1,
          "maxLength": 12
        }
      }
    },
    "coachCue": {
      "description": "指導者がピッチで子どもに掛ける短い言葉(任意・漢字可)。「保護者・指導者の方へ」欄に表示",
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "drills": {
      "description": "関連する練習メニュー(任意・漢字可)。「保護者・指導者の方へ」欄に表示",
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "players",
          "area",
          "rule",
          "success"
        ],
        "properties": {
          "title": {
            "description": "練習の名前",
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "players": {
            "description": "人数(例: 4対1、攻撃2人・守備1人)",
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "area": {
            "description": "広さ・準備(例: 10m四方、コーン4本)",
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "rule": {
            "description": "やり方・ルール(1〜2文)",
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "success": {
            "description": "成功の目安(できたと言える状態)",
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "note": {
            "description": "このシナリオとのつながり・注意(任意)",
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "この練習を動きで見せる練習メニュー(kind: drill)のシナリオ id(任意)。指導者向け欄に「動きで見る」ボタンを出す"
          }
        }
      }
    },
    "targetGrade": {
      "enum": [
        "low",
        "middle",
        "high"
      ],
      "description": "対象学年。low=1〜3年(ひらがなのみ)、middle=4年生(4年生までの漢字)、high=5〜6年"
    },
    "question": {
      "description": "Step 1 のあとに出す問いかけ(子どもに予想させる)。{h9} 形式の選手トークン可",
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "keyPoint": {
      "description": "最後に出す「今日のポイント」。原則を具体的な行動で1文に",
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "choices": {
      "description": "選択式の予想(任意)。問いかけの下に2〜3択を出し、選んでから答えを見る。正解はちょうど1つ",
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "correct",
          "feedback"
        ],
        "properties": {
          "text": {
            "description": "選択肢(子ども向け。{h9} トークン可)",
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "correct": {
            "type": "boolean"
          },
          "feedback": {
            "description": "答え合わせの一言(子ども向け)",
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        }
      }
    },
    "ruleNote": {
      "description": "ルールが大会で違う場面の注記(子ども向け。Step 1 の問いかけの下に小さく出す)",
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "teams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "home",
        "away"
      ],
      "properties": {
        "home": {
          "$ref": "#/$defs/team"
        },
        "away": {
          "$ref": "#/$defs/team"
        }
      }
    },
    "variants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "good",
        "bad"
      ],
      "properties": {
        "good": {
          "$ref": "#/$defs/variant"
        },
        "bad": {
          "$ref": "#/$defs/variant"
        }
      }
    },
    "area": {
      "description": "練習メニュー(kind: drill)で使う広さ(m)。座標は X=0〜w、Y=0〜h(Y=0 が画面の上)で書き、この範囲を拡大して描く",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "w",
        "h"
      ],
      "properties": {
        "w": {
          "type": "number",
          "minimum": 2,
          "maximum": 50
        },
        "h": {
          "type": "number",
          "minimum": 2,
          "maximum": 68
        }
      }
    },
    "practice": {
      "description": "練習メニュー(kind: drill)の指導者向けカード(漢字可・大人向け)。練習ページでは最初から開いて表示する。声かけは coachCue に書く",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setup",
        "howTo",
        "reps"
      ],
      "properties": {
        "setup": {
          "description": "準備(人数・広さ・コーンの数など)",
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "howTo": {
          "description": "やり方(1〜3文)",
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "reps": {
          "description": "回数・時間の目安",
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "levelUp": {
          "description": "レベルアップ(できたら次に変えること)",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "safety": {
          "description": "安全のための注意",
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "match": {
      "description": "練習メニュー(kind: drill)から、この技術を使う試合の場面へのリンク。結末の後に「▶ 試合ではこの場面」ボタンで出す",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "試合の場面(kind: match)のシナリオ id"
        }
      }
    }
  },
  "$defs": {
    "playerId": {
      "description": "h=home, a=away + 背番号。例: h7, a9",
      "type": "string",
      "pattern": "^[ha][1-9][0-9]?$"
    },
    "x": {
      "type": "number",
      "minimum": 0,
      "maximum": 50
    },
    "y": {
      "type": "number",
      "minimum": 0,
      "maximum": 68
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "$ref": "#/$defs/x"
        },
        "y": {
          "$ref": "#/$defs/y"
        }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "formation",
        "players"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 10
        },
        "formation": {
          "type": "string",
          "pattern": "^[0-9](-[0-9]){1,3}$"
        },
        "players": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "number",
              "role"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/playerId"
              },
              "number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 99
              },
              "role": {
                "enum": [
                  "GK",
                  "LB",
                  "CB",
                  "RB",
                  "LM",
                  "CM",
                  "RM",
                  "FW"
                ]
              }
            }
          },
          "description": "試合の場面(kind: match)は 8 人ちょうど。練習メニュー(kind: drill)は出てくる人だけ(0〜8 人)"
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "outcomeBanner",
        "steps"
      ],
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 12
        },
        "outcomeBanner": {
          "description": "Step 5 で大きく表示する結末の見出し",
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "outcomeTone": {
          "description": "結末の種類。chance=チャンス(緑)、pinch=ピンチ(赤)、miss=残念(灰。チャンスを逃した・相手ボールになった)。省略時は good=chance、bad=pinch",
          "enum": [
            "chance",
            "pinch",
            "miss"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "title",
        "explanation",
        "durationMs",
        "players",
        "ball",
        "overlays"
      ],
      "properties": {
        "phase": {
          "enum": [
            "initial",
            "movement",
            "firstPlay",
            "nextPlay",
            "outcome"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12
        },
        "explanation": {
          "description": "{h7} のような選手トークンを使うと画面で色付きの「7番」(low は「7ばん」)になる。表示文字数の目安は middle 40字 / low 30字。漢字は middle が4年生まで、low は使わない",
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "durationMs": {
          "description": "前ステップからこのステップの状態へ移るまでの実時間(ミリ秒)。等速再生時の長さ。",
          "type": "integer",
          "minimum": 500,
          "maximum": 6000
        },
        "focus": {
          "description": "強調する選手(省略時は explanation に出てくる選手)",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/playerId"
          }
        },
        "players": {
          "description": "このステップ終了時点の全選手の位置(キー=選手ID)",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/playerId"
          },
          "additionalProperties": {
            "$ref": "#/$defs/point"
          }
        },
        "ball": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "owner",
            "motion"
          ],
          "properties": {
            "x": {
              "$ref": "#/$defs/x"
            },
            "y": {
              "$ref": "#/$defs/y"
            },
            "owner": {
              "description": "このステップ終了時にボールを持っている選手。シュート中のみ null。",
              "oneOf": [
                {
                  "$ref": "#/$defs/playerId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "motion": {
              "description": "前ステップからこの位置へボールがどう動いたか",
              "enum": [
                "hold",
                "dribble",
                "ground",
                "air",
                "steal",
                "shot"
              ]
            },
            "offside": {
              "description": "このパスはオフサイド(ミスとして見せるために意図したもの)。motion が ground/air のときだけ使う",
              "type": "boolean"
            },
            "lofted": {
              "description": "浮き球(クロスなど)をカットした。motion が steal のときだけ使う。air と同じく浮いて見せる",
              "type": "boolean"
            }
          }
        },
        "overlays": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/arrow"
              },
              {
                "$ref": "#/$defs/passLane"
              },
              {
                "$ref": "#/$defs/space"
              },
              {
                "$ref": "#/$defs/triangle"
              },
              {
                "$ref": "#/$defs/callout"
              },
              {
                "$ref": "#/$defs/offsideLine"
              },
              {
                "$ref": "#/$defs/look"
              },
              {
                "$ref": "#/$defs/shotCone"
              },
              {
                "$ref": "#/$defs/cone"
              },
              {
                "$ref": "#/$defs/gate"
              }
            ]
          }
        },
        "foot": {
          "description": "足の使い方(練習メニュー用・任意)。説明欄に「あしもと」のアップ図を出し、ピッチにはその選手の軸足の足あとを置く。このステップの始めにボールにさわったとして描く",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "player",
            "kick",
            "surface"
          ],
          "properties": {
            "player": {
              "$ref": "#/$defs/playerId"
            },
            "kick": {
              "description": "ボールにさわる足",
              "enum": [
                "right",
                "left"
              ]
            },
            "surface": {
              "description": "ボールに当てる所。inside=足の内がわ、outside=足の外がわ、sole=足のうら、instep=くつひもの所、toe=つま先",
              "enum": [
                "inside",
                "outside",
                "sole",
                "instep",
                "toe"
              ]
            },
            "plant": {
              "description": "軸足のつま先の向き(度)。0 = ボールを送る方向。プラスは右回り",
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "toward": {
              "description": "ボールを送る先(選手ID・座標)。省略時はこのステップのボールの動き(動かない時は選手の動き)の向き",
              "oneOf": [
                {
                  "$ref": "#/$defs/playerId"
                },
                {
                  "$ref": "#/$defs/point"
                }
              ]
            },
            "judgement": {
              "description": "bad = よくあるミスの使い方(赤くぬる)。省略時は good",
              "enum": [
                "good",
                "bad"
              ]
            }
          }
        }
      }
    },
    "arrow": {
      "description": "このステップでの動きを示す矢印。from/to を省略すると、run/dribble は by の前ステップ位置→現ステップ位置、pass/shot はボールの前位置→現位置から自動で描く",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "kind",
        "by"
      ],
      "properties": {
        "type": {
          "const": "arrow"
        },
        "kind": {
          "enum": [
            "run",
            "dribble",
            "pass",
            "shot"
          ]
        },
        "by": {
          "$ref": "#/$defs/playerId"
        },
        "judgement": {
          "description": "bad にすると誤った動きとして赤い矢印+×で描く",
          "enum": [
            "good",
            "bad"
          ]
        },
        "from": {
          "$ref": "#/$defs/point"
        },
        "to": {
          "$ref": "#/$defs/point"
        }
      }
    },
    "passLane": {
      "description": "ステップ終了時点のパスコース(選手位置に追従)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "from",
        "to",
        "state"
      ],
      "properties": {
        "type": {
          "const": "passLane"
        },
        "from": {
          "$ref": "#/$defs/playerId"
        },
        "to": {
          "$ref": "#/$defs/playerId"
        },
        "state": {
          "enum": [
            "open",
            "blocked"
          ]
        }
      }
    },
    "space": {
      "description": "注目させたいスペース(楕円)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "x",
        "y",
        "rx",
        "ry"
      ],
      "properties": {
        "type": {
          "const": "space"
        },
        "x": {
          "$ref": "#/$defs/x"
        },
        "y": {
