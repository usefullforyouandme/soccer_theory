{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usefullforyouandme.github.io/soccer_theory/schema/scenario.schema.json",
  "title": "戦術アニメーション用シナリオ",
  "description": "8人制サッカー戦術学習アプリのシナリオデータ。座標系: X=0(左タッチライン)〜50(右), Y=0(相手ゴールライン)〜68(自陣ゴールライン)。home は Y=68 側から Y=0 側へ攻撃する。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "category",
    "group",
    "pattern",
    "theme",
    "targetGrade",
    "question",
    "keyPoint",
    "teams",
    "variants"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "description": "ファイル名と一致させる(kebab-case)",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "description": "テーマ名(同じテーマの別パターンは同じタイトルにする)",
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "category": {
      "description": "種類。build=ボールを前へ運ぶ、attack=ゴールをねらう、defend=ボールを取る・守る、transition=切りかえ、restart=リスタート・キーパー",
      "enum": [
        "build",
        "attack",
        "defend",
        "transition",
        "restart"
      ]
    },
    "group": {
      "description": "テーマのID(同じテーマの別パターンは同じ値にする)。例: counter-press",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "pattern": {
      "description": "パターン名(ボールの位置・守備の状況の違い)。一覧と画面の見出しに表示。例: サイドで取られた時",
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "theme": {
      "description": "指導者向けのテーマ説明(漢字可)",
      "type": "string",
      "minLength": 1
    },
    "coachNote": {
      "description": "指導者向けの補足(任意・漢字可)",
      "type": "string"
    },
    "coachCue": {
      "description": "指導者がピッチで子どもに掛ける短い言葉(任意・漢字可)。「保護者・指導者の方へ」欄に表示",
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "drills": {
      "description": "関連する練習メニュー(任意・漢字可)。「保護者・指導者の方へ」欄に表示",
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "description"
        ],
        "properties": {
          "title": {
            "description": "練習の名前",
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "description": {
            "description": "やり方と、このシナリオとのつながり(1〜3文)",
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "targetGrade": {
      "enum": [
        "low",
        "middle",
        "high"
      ],
      "description": "対象学年。low=1〜3年(ひらがなのみ)、middle=4年生(4年生までの漢字)、high=5〜6年"
    },
    "question": {
      "description": "Step 1 のあとに出す問いかけ(子どもに予想させる)。{h9} 形式の選手トークン可",
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "keyPoint": {
      "description": "最後に出す「今日のポイント」。原則を具体的な行動で1文に",
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "teams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "home",
        "away"
      ],
      "properties": {
        "home": {
          "$ref": "#/$defs/team"
        },
        "away": {
          "$ref": "#/$defs/team"
        }
      }
    },
    "variants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "good",
        "bad"
      ],
      "properties": {
        "good": {
          "$ref": "#/$defs/variant"
        },
        "bad": {
          "$ref": "#/$defs/variant"
        }
      }
    }
  },
  "$defs": {
    "playerId": {
      "description": "h=home, a=away + 背番号。例: h7, a9",
      "type": "string",
      "pattern": "^[ha][1-9][0-9]?$"
    },
    "x": {
      "type": "number",
      "minimum": 0,
      "maximum": 50
    },
    "y": {
      "type": "number",
      "minimum": 0,
      "maximum": 68
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "$ref": "#/$defs/x"
        },
        "y": {
          "$ref": "#/$defs/y"
        }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "formation",
        "players"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 10
        },
        "formation": {
          "type": "string",
          "pattern": "^[0-9](-[0-9]){1,3}$"
        },
        "players": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "number",
              "role"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/playerId"
              },
              "number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 99
              },
              "role": {
                "enum": [
                  "GK",
                  "LB",
                  "CB",
                  "RB",
                  "LM",
                  "CM",
                  "RM",
                  "FW"
                ]
              }
            }
          }
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "outcomeBanner",
        "steps"
      ],
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 12
        },
        "outcomeBanner": {
          "description": "Step 5 で大きく表示する結末の見出し",
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "outcomeTone": {
          "description": "結末の種類。chance=チャンス(緑)、pinch=ピンチ(赤)、miss=残念(灰。チャンスを逃した・相手ボールになった)。省略時は good=chance、bad=pinch",
          "enum": [
            "chance",
            "pinch",
            "miss"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "title",
        "explanation",
        "durationMs",
        "players",
        "ball",
        "overlays"
      ],
      "properties": {
        "phase": {
          "enum": [
            "initial",
            "movement",
            "firstPlay",
            "nextPlay",
            "outcome"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12
        },
        "explanation": {
          "description": "{h7} のような選手トークンを使うと画面で色付きの「7番」(low は「7ばん」)になる。表示文字数の目安は middle 40字 / low 30字。漢字は middle が4年生まで、low は使わない",
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "durationMs": {
          "description": "前ステップからこのステップの状態へ移るまでの実時間(ミリ秒)。等速再生時の長さ。",
          "type": "integer",
          "minimum": 500,
          "maximum": 6000
        },
        "focus": {
          "description": "強調する選手(省略時は explanation に出てくる選手)",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/playerId"
          }
        },
        "players": {
          "description": "このステップ終了時点の全選手の位置(キー=選手ID)",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/playerId"
          },
          "additionalProperties": {
            "$ref": "#/$defs/point"
          }
        },
        "ball": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "owner",
            "motion"
          ],
          "properties": {
            "x": {
              "$ref": "#/$defs/x"
            },
            "y": {
              "$ref": "#/$defs/y"
            },
            "owner": {
              "description": "このステップ終了時にボールを持っている選手。シュート中のみ null。",
              "oneOf": [
                {
                  "$ref": "#/$defs/playerId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "motion": {
              "description": "前ステップからこの位置へボールがどう動いたか",
              "enum": [
                "hold",
                "dribble",
                "ground",
                "air",
                "steal",
                "shot"
              ]
            },
            "offside": {
              "description": "このパスはオフサイド(ミスとして見せるために意図したもの)。motion が ground/air のときだけ使う",
              "type": "boolean"
            }
          }
        },
        "overlays": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/arrow"
              },
              {
                "$ref": "#/$defs/passLane"
              },
              {
                "$ref": "#/$defs/space"
              },
              {
                "$ref": "#/$defs/triangle"
              },
              {
                "$ref": "#/$defs/callout"
              },
              {
                "$ref": "#/$defs/offsideLine"
              },
              {
                "$ref": "#/$defs/shotCone"
              }
            ]
          }
        }
      }
    },
    "arrow": {
      "description": "このステップでの動きを示す矢印。from/to を省略すると、run/dribble は by の前ステップ位置→現ステップ位置、pass/shot はボールの前位置→現位置から自動で描く",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "kind",
        "by"
      ],
      "properties": {
        "type": {
          "const": "arrow"
        },
        "kind": {
          "enum": [
            "run",
            "dribble",
            "pass",
            "shot"
          ]
        },
        "by": {
          "$ref": "#/$defs/playerId"
        },
        "judgement": {
          "description": "bad にすると誤った動きとして赤い矢印+×で描く",
          "enum": [
            "good",
            "bad"
          ]
        },
        "from": {
          "$ref": "#/$defs/point"
        },
        "to": {
          "$ref": "#/$defs/point"
        }
      }
    },
    "passLane": {
      "description": "ステップ終了時点のパスコース(選手位置に追従)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "from",
        "to",
        "state"
      ],
      "properties": {
        "type": {
          "const": "passLane"
        },
        "from": {
          "$ref": "#/$defs/playerId"
        },
        "to": {
          "$ref": "#/$defs/playerId"
        },
        "state": {
          "enum": [
            "open",
            "blocked"
          ]
        }
      }
    },
    "space": {
      "description": "注目させたいスペース(楕円)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "x",
        "y",
        "rx",
        "ry"
      ],
      "properties": {
        "type": {
          "const": "space"
        },
        "x": {
          "$ref": "#/$defs/x"
        },
        "y": {
          "$ref": "#/$defs/y"
        },
        "rx": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 25
        },
        "ry": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 34
        },
        "label": {
          "type": "string",
          "maxLength": 12
        }
      }
    },
    "triangle": {
      "description": "3人で作るトライアングル(選手位置に追従)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "players"
      ],
      "properties": {
        "type": {
          "const": "triangle"
        },
        "players": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/playerId"
          }
        }
      }
    },
    "callout": {
      "description": "選手の頭上に出す吹き出し(良い動き/悪い動きをその場で示す)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "player",
        "text",
        "tone"
      ],
      "properties": {
        "type": {
          "const": "callout"
        },
        "player": {
          "$ref": "#/$defs/playerId"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8
        },
        "tone": {
          "enum": [
            "good",
            "bad"
          ]
        }
      }
    },
    "goalSide": {
      "description": "away = 相手のゴール(Y=0)側、home = 自分のゴール(Y=68)側",
      "enum": [
        "home",
        "away"
      ]
    },
    "offsideLine": {
      "description": "オフサイドライン。守っているチームの後ろから2人目(またはボール)の位置に横線を引く。選手の動きに追従する",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "defending"
      ],
      "properties": {
        "type": {
          "const": "offsideLine"
        },
        "defending": {
          "$ref": "#/$defs/goalSide",
          "description": "守っているチーム"
        }
      }
    },
    "shotCone": {
      "description": "シュートコース。ボールまたは選手と、ゴールの両ポストを結ぶ三角形",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "from",
        "goal"
      ],
      "properties": {
        "type": {
          "const": "shotCone"
        },
        "from": {
          "oneOf": [
            {
              "$ref": "#/$defs/playerId"
            },
            {
              "const": "ball"
            }
          ]
        },
        "goal": {
          "$ref": "#/$defs/goalSide",
          "description": "ねらうゴール"
        },
        "centerLine": {
          "description": "三角形の真ん中の線(キーパーが立つ目安)を描く",
          "type": "boolean"
        },
        "label": {
          "type": "string",
          "maxLength": 12
        }
      }
    }
  }
}
