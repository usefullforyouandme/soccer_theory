  "id": "press-and-cover-center",
  "title": "1人が行く、1人がカバー",
  "questionTitle": "2人でどうやって守る?",
  "category": "defend",
  "group": "press-and-cover",
  "keyword": "protect",
  "courseOrder": 7,
  "pattern": "中央の守り",
  "theme": "ボールに行く人(1人目)と、その後ろで守る人(カバー)の役割分担",
  "coachNote": "自陣中央でドリブルしてくる相手に対し、MF(6)が前から寄せ、CB(4)はゴール前に残ってカバーする。中央ではカバーの人が出ていくと、その後ろ(ゴール前)が空いてしまう。4番が出ていく時は、となりの3番が中へしぼって相手9番を見る「ずれ」も見せる。bad は4番が6番といっしょに前へ出てしまい、背後へのパスでシュートまで行かれ、コーナーキックをあたえる例。",
  "coachCue": "前の人が行く!後ろはゴールの前!",
  "drills": [
    {
      "title": "1人目とカバーの守備",
      "players": "攻撃1人・守備2人",
      "area": "15m×20m とミニゴール",
      "rule": "1人目がボールに寄せ、2人目はななめ後ろに立つ。1人目がかわされたら2人目がすぐ寄せ、1人目は後ろへもどって役を入れかえる。",
      "success": "ミニゴールにシュートさせない回数が5回中4回"
    },
    {
      "title": "カバーの位置当て",
      "players": "守備2人+コーチ",
      "area": "15m×15m",
      "rule": "コーチがボールを動かし、守備2人が「行く人」と「後ろで助ける人(カバー)」の位置に走る。",
      "success": "カバーの人が、1人目とゴールの両方が見えるななめ後ろに立てたら成功"
    }
  ],
