  "title": "体をひらいて受けよう",
  "questionTitle": "パスが来る!体はどっちに向ける?",
  "category": "build",
  "group": "open-body",
  "keyword": "move",
  "courseOrder": 37,
  "pattern": "真ん中で",
  "theme": "パスを受ける時は、出し手と前の両方が見えるように体を半分ひらき、遠い方の足で受けて、最初のタッチで前へ運ぶ",
  "coachNote": "自陣でCB(4)からCM(6)へパスが出る場面。前の右側にRM(8)が空いていて、相手CM(6)が左前から近づいてくる。6は4と前の両方が見えるように体を半分ひらき、遠い方の足(右足)で受けて、最初のタッチで右前へ運ぶ。相手からはなれて前を向けるので、すぐに8へつなげる。bad は6が体をボールの方へ向けたまま足元に止め、相手にせなかにつかれて、4へもどすしかなくなる例。A4(もらう前に見る)では「見たかどうか」、ここでは見た後の「体の向きと最初のタッチ」をちがいにしてある。",
  "coachCue": "体をひらいて、前へ運ぼう!",
  "drills": [
    {
      "title": "ひらいて受けるパス交換",
      "players": "出し手1人・受け手1人",
      "area": "10m はなれて向かい合う。受け手の横と前にコーンのゲート",
      "rule": "受け手は体を半分ひらいて(出し手と前の両方が見える向きで)待ち、遠い方の足で受けて、最初のタッチで前のゲートへ運ぶ。",
      "success": "10本中7本、1回目のタッチで前のゲートをぬけられる"
    },
    {
      "title": "後ろから鬼が来る3人パス",
      "players": "出し手1人・受け手1人・鬼1人",
      "area": "15m×10m",
      "rule": "受け手の後ろから鬼が近づく。ひらいて受けて前を向けたら1点、後ろへもどしたら0点。",
      "success": "5回中3回、前を向いてから次のパスを出せる",
      "note": "見ること(A4)ができていても、体がボールの方を向いたままだと前を向けない"
    }
  ],
