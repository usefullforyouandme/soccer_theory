{
  "schemaVersion": 2,
  "id": "take-on-box",
  "title": "1対1でしかけよう",
  "questionTitle": "1対1!どうやってぬく?",
  "category": "attack",
  "group": "take-on",
  "keyword": "goal",
  "courseOrder": 4,
  "pattern": "ゴール前の1対1",
  "theme": "1対1でボールを持った時に、相手の立ち方(どちらをふさいでいるか)と足を出すタイミングを見て、空いている方へスピードに乗ってぬく",
  "coachNote": "ペナルティエリアの手前で、FW(9)と相手CB(4)の1対1。相手が足を出しに来た瞬間は、体重がその足にのって反対側へは動けない。9は相手に向かって運び、足が出た瞬間に反対へボールを動かせば、ぬいてシュートまで行ける。bad は相手が待っている正面へまっすぐ進み、出した足に当てられて取られる例。U-10 では細かいフェイントより、「相手を見て、足が出たら反対」という1つの合図を覚えさせると、試合で使いやすい。",
  "coachCue": "足が出たら、反対へ!",
  "drills": [
    {
      "title": "ゲートをぬける1対1",
      "players": "攻撃1人・守備1人",
      "area": "15m×10m。奥にコーンのゲートを左右に2つ",
      "rule": "守備は片方のゲートの前に立つ。攻撃はスピードに乗って向かい、守備が立っていない方のゲートをドリブルでぬける。",
      "success": "空いている方のゲートを5回中3回ぬけられる"
    },
    {
      "title": "足が出たら反対へ",
      "players": "攻撃1人・守備1人",
      "area": "10m×10m とミニゴール",
      "rule": "守備が足を出したら、その反対側へボールを動かしてぬき、ミニゴールへシュート。",
      "success": "ぬいた後、2タッチ以内でシュートまで行ける",
      "note": "相手の正面で止まらない。スピードを落とすのは、ぬく直前だけ"
    },
    {
      "title": "ジグザグドリブル",
      "players": "1人1球",
      "area": "コーン4本を2.5m おきに一直線",
      "rule": "コーンの左右を交互に通る。右足の内側と外側で細かくさわり、ボールを体の近くに置く。",
      "success": "コーンに当てずに、最後までボールを足のそばに置ける",
      "note": "1対1でぬく前の、足もとの土台",
      "id": "zigzag-dribble"
    }
  ],
