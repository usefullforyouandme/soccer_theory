{
  "schemaVersion": 2,
  "id": "intercept-or-hold-front",
  "title": "取れるパスは前で取ろう",
  "questionTitle": "相手のFWへパスが来る!どうする?",
  "category": "defend",
  "group": "intercept-or-hold",
  "keyword": "protect",
  "courseOrder": 31,
  "pattern": "相手のFWへのパス",
  "theme": "相手 FW へのパスが出そうな時、CB が出し手と FW を見て「取れる」と判断したら前に出てパスを取る(取れない時は後ろから寄せて前を向かせない)",
  "coachNote": "相手 CM(6)から、下がってきた相手 FW(9)へ短いパスが出そうな場面。CB(4)はボールと FW の両方を見て、パスが近くて取れそうなら FW の前に出て取る(インターセプト)。取れれば、そのまま攻撃に切りかえられる。bad はゴールの方へ下がって待つ例(まちがった方向へ動くミス)で、FW に前を向かれてシュートまで行かれる。取れない遠いパスの時は飛びこまず、後ろから体を寄せて前を向かせない、という反対の判断もあることを補足する(C1 カバー・C2 ゴール前の守りの前に見せるとよい)。",
  "coachCue": "取れるパスは、前に出て取ろう!",
  "drills": [
    {
      "title": "前で取る・後ろで待つ",
      "players": "出し手1人・相手FW1人・守備1人",
      "area": "15m×10m",
      "rule": "コーチがパスの速さを変える。取れるパスは相手の前に出て取り、取れないパスは後ろについて前を向かせない。",
      "success": "5回中4回、正しい方を選べる"
    },
    {
      "title": "インターセプト1対1",
      "players": "攻撃2人・守備1人",
      "area": "20m×15m",
      "rule": "出し手から相手FWへのパスを、守備が前に出て取ったら2点、前を向かせなければ1点。",
      "success": "前を向かせた回数が5回中1回以下",
      "note": "飛びこんでとどかない時は、後ろから体をよせて前を向かせない"
    }
  ],
