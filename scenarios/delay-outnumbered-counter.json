{
  "schemaVersion": 2,
  "id": "delay-outnumbered-counter",
  "title": "数で負けている時はおくらせる",
  "questionTitle": "1人で2人を守る時は?",
  "category": "defend",
  "group": "delay-outnumbered",
  "keyword": "protect",
  "courseOrder": 9,
  "pattern": "カウンターで2対1",
  "theme": "数的不利(1対2)の時は飛びこまず、2人の間・ゴールとボールの間に立って時間をかせぎ、味方のもどりを待つ",
  "coachNote": "相手陣でボールを奪われ、相手FW(9)とMF(8)の2人に対しCB(4)が1人で残された場面。4は飛びこまず、斜めに下がりながら2人の間に立ち、ドリブルのスピードを落とさせる。その間にCM(6)が全力でもどり、2対2になってから後ろとはさんで奪う。bad は4がボールに飛びこみ、横パス1本でかわされて背後がガラ空きになり、GKと1対1になる例。C1(1人が行く、1人がカバー)とちがい、カバーがいない「1人で2人」の時は、取りに行くより時間をかせぐことが優先になる。",
  "coachCue": "下がりながら、2人の間に立て!",
  "drills": [
    {
      "title": "1対2のおくらせゲーム",
      "players": "攻撃2人・守備1人(+もどる守備1人)",
      "area": "幅15m×長さ25m とゴール",
      "rule": "守備は飛びこまずに下がりながら2人を前に見る。5秒たつと、味方の守備がもう1人入る。",
      "success": "5秒シュートを打たせなければ守備の勝ち"
    },
    {
      "title": "もどる人とのはさみ",
      "players": "攻撃2人・守備2人",
      "area": "幅15m×長さ25m",
      "rule": "1人目はおくらせ役、2人目は遠くからもどる役。もどる人が着いたら「着いた!」と声をかけ、2人ではさんで取る。",
      "success": "声をかけてから取りに行けた回数が半分をこえる"
    }
  ],
  "targetGrade": "middle",
