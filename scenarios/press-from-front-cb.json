  "id": "press-from-front-cb",
  "title": "道をふさいで近づこう",
  "questionTitle": "相手のDFがボールを持った!FWは?",
  "category": "defend",
  "group": "press-from-front",
  "keyword": "protect",
  "courseOrder": 30,
  "pattern": "相手のDFが持った時",
  "theme": "相手 CB がボールを持った時、FW がまっすぐ寄せずに片方へのパスの道を体でふさぎながら近づき、味方が待つ方へパスを出させて取る",
  "coachNote": "相手 CB(4)が自陣でボールを持ち、左右に SB(3・2)がいる場面。FW(9)がまっすぐ寄せると、4 はどちらへもパスできる。9 が右から回って近づけば、相手 2 へのパスの道を体でふさげるので、4 は味方 LM(7)が待つ左の 3 へ出すしかない。出た先で 7 が寄せて取る。bad はまっすぐ全力で寄せて、空いている 2 へかんたんにつながれる例(まちがった方向へ動くミス)。U-10 では「まっすぐ行かない・回って行く」の 1 点でよい。FW が守備のスタートになることを、D1(取られたらすぐ取り返す)とあわせて伝える。",
  "coachCue": "パスの道をふさぎながら、近づこう!",
  "drills": [
    {
      "title": "道をふさぐ寄せ方",
      "players": "守備1人・攻撃3人(真ん中1人と左右1人ずつ)",
      "area": "20m×15m",
      "rule": "守備は片方へのパスの道を体でふさぎながら真ん中の人へ近づき、もう片方へ出させる。",
      "success": "コーチが決めた方へ、5回中3回パスを出させられる"
    },
    {
      "title": "前から取るゲーム",
      "players": "FW1人+MF2人 対 DF3人",
      "area": "半分のコート",
      "rule": "FWがパスの道をふさいで追いこみ、出された先でMFが取る。",
      "success": "取れたら2点。追いこんだ方で取れた回数を数える"
    }
  ],
