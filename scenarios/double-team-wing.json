{
  "schemaVersion": 2,
  "id": "double-team-wing",
  "title": "2人ではさもう",
  "questionTitle": "外へ追い出した!次はどうする?",
  "category": "defend",
  "group": "double-team",
  "keyword": "protect",
  "courseOrder": 39,
  "pattern": "タッチラインの近くで",
  "theme": "1人目が内側から近づいて相手をタッチラインの方へ向かわせたら、2人目が前からふさいで、2人ではさんで取る",
  "coachNote": "自陣の右サイドを相手LM(7)がドリブルし、近くに相手の味方がいない場面。RM(8)が後ろから追いかけて内側から近づき、7をタッチラインの方へ向かわせる(C3)。RB(3)は7の前からふさぎに行き、タッチライン・8・3の3つではさんで取る。bad は3が真ん中で待ったままで、7が前の空いた所へ運び、ゴール前へパスを出してピンチになる例。C1(1人が行く、1人がカバー)とのちがいは、相手の行く道がタッチラインでせまくなっている時は、2人目も前から取りに行ってよいこと。中へ向かわれた時や、相手の味方が近くにいる時は、C1 のカバーにもどる。",
  "coachCue": "外へ追い出したら、前からはさもう!",
  "drills": [
    {
      "title": "タッチラインではさむ2対1",
      "players": "攻撃1人・守備2人",
      "area": "幅10m×長さ20m。片側をタッチラインにする",
      "rule": "1人目が内側からついて外へ向かわせ、2人目が前からふさぐ。2人で「はさむ!」と声をかけてから取りに行く。",
      "success": "5回中3回、はさんで取れる"
    },
    {
      "title": "2人目はどこから?",
      "players": "攻撃1人・守備2人+コーチ",
      "area": "20m×15m",
      "rule": "コーチの合図で攻撃が運ぶ。2人目は、ボールが外へ向かった時だけ前からふさぎに行き、中へ向かったら後ろでカバーする。",
      "success": "外か中かで、2人目の動きを正しく選べる",
      "note": "1人目とカバー(C1)のあとの段階。外へ追い出して、相手の行く道がなくなった時が取りどき"
    }
  ],
