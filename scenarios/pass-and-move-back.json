  "schemaVersion": 2,
  "id": "pass-and-move-back",
  "title": "パスしたら動こう",
  "questionTitle": "パスを出した!そのあとどうする?",
  "category": "build",
  "group": "pass-and-move",
  "keyword": "move",
  "courseOrder": 38,
  "pattern": "サイドで後ろへもどした時",
  "theme": "パスを出したら、その場に止まらずに、相手と相手の間など次にもらえる空いた所へ動き直す。もどした時も同じ",
  "coachNote": "相手陣に近い左サイドで、LM(7)が前を相手RM(8)にふさがれ、後ろのLB(2)へもどす場面。相手8はボールを追って2の方へ向かう。7はその場に止まらずに、8からはなれて中の空いた所へ動き直し、2からもう一度受けて前を向く。bad は7がタッチライン近くで止まったままで、2の方へ向かった8のかげ(パスの道の上)にかくれてしまい、2が出す所をなくして取られる例。「もどす=終わり」ではなく、もどした後の動き直しで前へ行けることを伝える。",
  "coachCue": "もどしたら、空いた所へ動き直そう!",
  "drills": [
    {
      "title": "出したら動く4対2",
      "players": "攻撃4人・守備2人",
      "area": "15m×15m",
      "rule": "パスを出した人は、すぐに別の空いている所へ動く。出した場所に止まったままの人がいたら相手ボール。",
      "success": "10本続けてつながれば守備と交代"
    },
    {
      "title": "出して前へ走るパス回し",
      "players": "3人+守備1人",
      "area": "幅15m×長さ25m",
      "rule": "パスを出したら前のスペースへ走り、もう一度もらってラインまで運ぶ。",
      "success": "5回中3回、出した人がもう一度もらえる",
      "note": "ワンツー(B2)は「同じ人に返してもらう」。ここでは次の味方を助けるために動く"
    }
  ],
  "targetGrade": "middle",
  "question": "{h7}は前をふさがれて、{h2}へもどす。もどした後、{h7}はどうすればいいかな?",
  "keyPoint": "もどしたら、相手からはなれて、もう一度もらえる所へ!",
