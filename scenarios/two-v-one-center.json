{
  "schemaVersion": 2,
  "id": "two-v-one-center",
  "title": "2対1は引きつけてからパス",
  "questionTitle": "2人対1人!いつパスを出す?",
  "category": "attack",
  "group": "two-v-one",
  "keyword": "goal",
  "courseOrder": 5,
  "pattern": "中央で",
  "theme": "数的優位(2対1)では、ボール保持者が守備者に向かって運び、守備者を自分に引きつけてから空いた味方へパスする",
  "coachNote": "相手陣中央で、CM(6)とRM(8)に対し相手CB(4)が1人の場面(ほかの相手DFはサイドの7・9についている)。6は相手4の正面へ運び、4が止めに出てきた瞬間に横の8へ出す。bad は「引きつける」までは正しいが、4が来てもドリブルを続けて奪われる例。サイドのパターン(早すぎるパス)と並べると、「相手が来た時」がパスの合図だと伝わる。B5(ドリブルか、パスか:2人にはさまれそうな時)とも関連づけて説明するとよい。",
  "coachCue": "正面へ運べ!来たら横へ!",
  "drills": [
    {
      "title": "2対1のライン突破",
      "players": "攻撃2人・守備1人",
      "area": "幅15m×長さ20m",
      "rule": "ボール保持者は守備者に向かって運び、守備者が自分に来たらパス、来なければそのまま運んでラインを突破する。",
      "success": "5回中3回ラインをこえられる"
    },
    {
      "title": "パスの合図を決める",
      "players": "攻撃2人・守備1人",
      "area": "幅15m×長さ20m",
      "rule": "守備者が「自分の方へ一歩出た」瞬間をパスの合図にする。早すぎるパス・おそすぎるパスのどちらも、コーチが止めて場所を確かめる。",
      "success": "合図の一歩でパスを出せた回数が半分をこえる"
    }
  ],
  "targetGrade": "middle",
  "question": "2人対1人だ!{h6}はいつパスを出せばいいかな?",
  "keyPoint": "守る人を自分に引きつけてから、空いた味方へ出そう!",
