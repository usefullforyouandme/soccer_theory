  "schemaVersion": 2,
  "id": "fk-attack-front",
  "title": "味方のフリーキック",
  "questionTitle": "味方のフリーキック!どうせめる?",
  "category": "restart",
  "group": "fk-attack",
  "keyword": "goal",
  "courseOrder": 42,
  "pattern": "ゴール正面から",
  "theme": "味方のフリーキックでは、かべがじゃまな時は横へずらして角度を作る。相手がならぶ前なら、すぐに始めて空いている所を使う",
  "coachNote": "相手ゴールの正面、約20mでの味方フリーキック(キッカーはCM(6))。相手は6番と9番の2人でかべを作っている。RM(8)がかべの横へ動き、6からの短いパスを受けて1回さわれば、かべが間に入らずにゴールが見える。bad は6がそのままゴールへけってかべに当て、はね返りを相手に拾われる例。4年生のキック力では、かべをこえて決めるのはむずかしいので、「かべの横へずらす」を先に教える。かべまでのきょりは大会のルールに合わせる。E8「相手のフリーキックの守り」と並べて、守る側が横の相手につく理由も伝えるとよい。",
  "coachCue": "かべの横へ動こう!",
  "drills": [
    {
      "title": "かべの横からシュート",
      "players": "キッカー1人・横の人1人・かべ役2人+キーパー",
      "area": "ゴール正面 20m のあたり",
      "rule": "横の人がかべの横へ動き、キッカーが短いパス。横の人は1回で角度を作ってシュート。",
      "success": "5回中3回、かべに当てずにシュートまで行ける"
    },
    {
      "title": "すぐ始めるフリーキック",
      "players": "攻撃3人・守備3人+キッカー",
      "area": "半分のコート",
      "rule": "コーチがファウルの合図をしたら、相手がもどる前に、空いている味方へすぐパスを出す。",
      "success": "合図から3秒以内に始めて、前へ進める",
      "note": "笛を待つルールの大会では、笛を聞いてからすぐ始める"
    }
  ],
  "targetGrade": "middle",
  "question": "ゴールの正面でフリーキック。前に相手のかべ。どうすればシュートを打てるかな?",
  "keyPoint": "かべの横へずらして、角度を作ろう!",
  "ruleNote": "かべのきょりや笛のルールは、大会によってちがうよ",
