  "id": "shoot-when-open-angle",
  "title": "打てる時はシュート",
  "questionTitle": "シュート?それともパス?",
  "category": "attack",
  "group": "shoot-when-open",
  "keyword": "goal",
  "courseOrder": 14,
  "pattern": "角度がない時",
  "theme": "シュートコースが空いている時は、パスに逃げずにシュートを選ぶ(打てる時に打つ判断)",
  "coachNote": "LM(7)が相手3をぬいて、ペナルティエリアの左のななめ横まで運んだ場面。角度がなくても、キーパーの足元へ低く強く打てば、入らなくてもはじいたボールが反対側(ファー)へ転がり、つめていた8が押しこめる(B4「シュートの後につめよう」とつながる)。bad はもっと良い角度を探してゴールラインの方へ運び続け、もどってきた相手4・3に取られる例。「打てる時に打つ」ことと、「低く打つ」ことを合わせて伝える。",
  "coachCue": "角度がなくても、低く打て!",
  "drills": [
    {
      "title": "打てたら打つゲーム",
      "players": "3対3+キーパー",
      "area": "ペナルティエリアの外まで",
      "rule": "シュートコースが空いていたら、ペナルティエリアの外からでも打つ。打たずに横パスをしたらコーチが止めて、コースを確かめる。",
      "success": "打てる時に打った回数が、パスに逃げた回数より多い"
    },
    {
      "title": "角度のないシュート+つめ",
      "players": "シューター1人・つめ役1人・キーパー",
      "area": "ゴールのななめ横",
      "rule": "角度がない所から、キーパーの足元へ低く強く打つ。つめ役は反対側(ファー)へ走りこむ。",
      "success": "シュートかつめで、5回中2回ゴールできる",
      "note": "高いボールより、低いボールの方がキーパーははじきやすい"
    }
  ],
