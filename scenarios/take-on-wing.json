{
  "schemaVersion": 2,
  "id": "take-on-wing",
  "title": "1対1でしかけよう",
  "questionTitle": "1対1!どうやってぬく?",
  "category": "attack",
  "group": "take-on",
  "keyword": "goal",
  "courseOrder": 4,
  "pattern": "サイドの1対1",
  "theme": "1対1でボールを持った時に、相手の立ち方(どちらをふさいでいるか)と足を出すタイミングを見て、空いている方へスピードに乗ってぬく",
  "coachNote": "相手陣の左サイドで、LM(7)と相手RB(3)の1対1。ほかの味方には相手がついていて、2対1(B7)は作れない場面。相手3は内側(ゴールの方)をふさいで立っているので、空いているのは外(タッチライン沿いの縦)。7はスピードに乗って相手に向かい、相手が止まった瞬間に縦へぬけば、ゴールライン近くから後ろへのパスでチャンスになる。bad は相手がふさいでいる内側へ入っていき、相手3と6にはさまれて取られる例(ドリブル自体は良いプレーで、ミスは「ぬく方向」の1点)。U-10 では、ドリブルで仕掛けること自体をほめ、方向の判断を後から整理するとよい。",
  "coachCue": "スピードに乗って、空いている方へ!",
  "drills": [
    {
      "title": "ゲートをぬける1対1",
      "players": "攻撃1人・守備1人",
      "area": "15m×10m。奥にコーンのゲートを左右に2つ",
      "rule": "守備は片方のゲートの前に立つ。攻撃はスピードに乗って向かい、守備が立っていない方のゲートをドリブルでぬける。",
      "success": "空いている方のゲートを5回中3回ぬけられる"
    },
    {
      "title": "足が出たら反対へ",
      "players": "攻撃1人・守備1人",
      "area": "10m×10m とミニゴール",
      "rule": "守備が足を出したら、その反対側へボールを動かしてぬき、ミニゴールへシュート。",
      "success": "ぬいた後、2タッチ以内でシュートまで行ける",
      "note": "相手の正面で止まらない。スピードを落とすのは、ぬく直前だけ"
    },
    {
      "title": "ジグザグドリブル",
      "players": "1人1球",
      "area": "コーン4本を2.5m おきに一直線",
      "rule": "コーンの左右を交互に通る。右足の内側と外側で細かくさわり、ボールを体の近くに置く。",
      "success": "コーンに当てずに、最後までボールを足のそばに置ける",
      "note": "1対1でぬく前の、足もとの土台",
      "id": "zigzag-dribble"
    }
  ],
