  "schemaVersion": 2,
  "id": "run-behind-long",
  "title": "相手の後ろへ走るタイミング",
  "questionTitle": "いつ走り出せばいい?",
  "category": "attack",
  "group": "run-behind",
  "keyword": "look",
  "courseOrder": 17,
  "pattern": "後ろからの長いパス",
  "theme": "オフサイドにならない動き出し(相手の守備ラインとならんで待ち、パスが出るのと同時に走る)",
  "coachNote": "相手の守備ラインが高く前に出ている時に、CB(4)がハーフウェーライン近くまで運んでから、長いパスで背後をねらう場面(4年生のCBのキックで届く20m前後にしている。届かない距離からねらうと相手に取られるだけなので、まず運んでからける)。相手のラインが高いほど背後のスペースは広いが、FW(9)が早く出るとオフサイドになる。ラインとならんで待ち、4がけるのと同時に走れば、キーパーと1対1になれる。bad は9が4のけるタイミングを見ておらず、走り出すのがおそくて、長いパスに相手CBが先に追いつく例(中央・サイドのパターンの「早すぎ」と逆の「おそすぎ」のミス。3パターンで、タイミングが早すぎても、おそすぎてもいけないことを伝える)。",
  "coachCue": "けるまで待って、けったら走れ!",
  "drills": [
    {
      "title": "合図で飛び出し",
      "players": "出し手1人・受け手2〜3人",
      "area": "20m×20m。守備ライン役のコーン",
      "rule": "受け手はコーンとならんで立ち、出し手がボールをけった瞬間に走り出す。",
      "success": "けるより前に動かず、けった瞬間に走れたら成功"
    },
    {
      "title": "オフサイドあり3対2",
      "players": "攻撃3人・守備2人+キーパー",
      "area": "半分のコート",
      "rule": "守備2人のラインを意識した3対2。オフサイドの位置にいる人へのパスは相手ボール。",
      "success": "オフサイドにならずに、後ろへぬけ出せる"
    }
  ],
