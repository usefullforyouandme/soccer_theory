  "id": "defend-stance-wing",
  "title": "ななめに立って外へ",
  "questionTitle": "サイドで1対1!どう立つ?",
  "category": "defend",
  "group": "defend-stance",
  "keyword": "protect",
  "courseOrder": 32,
  "pattern": "サイドで1対1",
  "theme": "サイドで相手と 1 対 1 になった時、体をななめにして中側をふさぎ、タッチラインの方へ向かわせてから取る",
  "coachNote": "自陣の左サイドで、LB(2)と相手 RM(8)の 1 対 1。2 は少し中側に立ち、体をななめ(半身)にして、ゴールへの道(中)をふさぐ。相手は空いている外へ行くしかなく、タッチラインが「もう1人の守備」になる。ならんで走りながら、ボールが体からはなれた瞬間に取る。bad は正面に立ってボールに足を出す(飛びこむ)例で、よけられて中へぬかれ、シュートを打たれる。C3(外へ追い出そう)は寄せる方向、こちらは寄せた後の構え方に絞っている。",
  "coachCue": "ななめに立って、外へ向かわせよう!",
  "drills": [
    {
      "title": "ななめの構えで1対1",
      "players": "攻撃1人・守備1人",
      "area": "幅10m×長さ15m。片側をタッチラインにする",
      "rule": "守備は体をななめにして中側をふさぎ、外へ向かわせる。足を出すのは、ボールが体からはなれた時だけ。",
      "success": "外へ向かわせて、5回中3回ラインまで行かせない"
    },
    {
      "title": "構えのじゃんけん",
      "players": "2人1組",
      "area": "5m×5m",
      "rule": "コーチの「右」「左」で、守備役はその方向をあけた構えにすばやく変える。",
      "success": "合図から1秒以内に構えを変えられる"
    }
  ],
