  "title": "相手と相手の間で受けよう",
  "questionTitle": "真ん中で、どこでもらう?",
  "category": "build",
  "group": "receive-between",
  "keyword": "move",
  "courseOrder": 26,
  "pattern": "真ん中で",
  "theme": "相手の中盤がならんで守っている時、CM がボールに寄らずに相手と相手の間(相手の後ろ側)に入って受け、前を向く",
  "coachNote": "CB(4)がボールを持ち、相手の MF 3 人(8・6・7)が横にならんで守っている場面。CM(6)が相手の前でもらうと、後ろ向きで受けることになり、後ろから寄せられる。相手 6 と 7 の間(相手の背中側)に入れば、パスが通った時点で相手を 1 列こえていて、すぐ前を向ける。bad はボールに近よって相手 6 の前で受け、後ろから取られる例(まちがった方向へ動くミス)。A1(顔を出す)は「追われた味方を助ける」、こちらは「相手の間に立つ」に絞っている。A4(もらう前に周りを見よう)の次に見せるとよい。",
  "coachCue": "相手と相手の間に立とう!",
  "drills": [
    {
      "title": "ゲートの間で受ける",
      "players": "出し手1人・受け手1人・守備2人",
      "area": "20m×15m。守備2人の間に5mのゲート",
      "rule": "守備2人は横にならんで動く。受け手は2人の間(ゲートの後ろ)に入ってパスを受け、前を向いてからラインまで運ぶ。",
      "success": "5回中3回、受けてすぐ前を向ける"
    },
    {
      "title": "間を通すロンド",
      "players": "攻撃5人・守備2人",
      "area": "15m×15m。真ん中に受け手1人",
      "rule": "外の4人は、守備2人の間にいる真ん中の人へパスを通したら1点。真ん中の人は、守備の前に出ずに間で待つ。",
      "success": "1分間で間を通すパスが3本"
    }
  ],
