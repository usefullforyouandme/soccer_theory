  "id": "track-back-overlap",
  "title": "ついてもどろう",
  "questionTitle": "前の相手が走り出した!どうする?",
  "category": "defend",
  "group": "track-back",
  "keyword": "protect",
  "courseOrder": 33,
  "pattern": "相手のサイドDFが上がってきた時",
  "theme": "自分の前にいた相手 SB が後ろから上がってきた時、サイド MF がボールだけを見ずに、その相手とならんでもどってパスの道に入る",
  "coachNote": "相手 LM(7)がボールを持ち、その後ろから相手 LB(2)がタッチライン沿いに上がってくる場面。RM(8)は自分の前にいた 2 を見て、ならんでもどる。7 から 2 へのパスが出れば、8 が先にさわって取れる。RB(3)は 7 の前に立ったまま守れる。bad はボールを見てボールの方へよってしまい(まちがった方向へ動くミス)、2 にサイドの後ろを走られてゴール前へ入れられる例。D3(取られたらもどる道)は切りかえの直後、こちらは守備中に「自分の相手を最後まで見る」ことに絞っている。",
  "coachCue": "前の相手が走ったら、いっしょにもどろう!",
  "drills": [
    {
      "title": "ついてもどるレース",
      "players": "攻撃1人・守備1人+パスの出し手",
      "area": "サイド 幅10m×長さ25m",
      "rule": "攻撃役が後ろから走り出したら、守備役はならんでもどる。出し手のパスを守備役が先にさわったら勝ち。",
      "success": "5回中3回、先にさわれる"
    },
    {
      "title": "マークの受けわたし",
      "players": "4対4",
      "area": "半分のコート",
      "rule": "自分の前の相手が走ったら声を出してついていく。ボールだけを見て相手を放したらコーチが止めて確かめる。",
      "success": "走った相手を最後まで見ていられる"
    }
  ],
