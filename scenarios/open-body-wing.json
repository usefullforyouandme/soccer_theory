  "courseOrder": 37,
  "pattern": "サイドで",
  "theme": "パスを受ける時は、出し手と前の両方が見えるように体を半分ひらき、遠い方の足で受けて、最初のタッチで前へ運ぶ",
  "coachNote": "自陣の左サイドで、LB(2)からタッチライン沿いのLM(7)へパスが出る場面。前から相手RM(8)が近づいてくる。7はタッチラインにせなかを向けて、ピッチの中と前が見える向きで待ち、遠い方の足で受けて、最初のタッチで中の前へ運ぶ。8の横をぬけられるので、中のCM(6)へつなげる。bad は7がタッチラインの方(2の方)を向いて止めて受け、前から来た8にせなかをとられて、2へもどすしかなくなる例。サイドでは向きが悪いとタッチラインと相手にはさまれやすいことを伝える。",
  "coachCue": "中が見える向きで受けよう!",
  "drills": [
    {
      "title": "ひらいて受けるパス交換",
      "players": "出し手1人・受け手1人",
      "area": "10m はなれて向かい合う。受け手の横と前にコーンのゲート",
      "rule": "受け手は体を半分ひらいて(出し手と前の両方が見える向きで)待ち、遠い方の足で受けて、最初のタッチで前のゲートへ運ぶ。",
      "success": "10本中7本、1回目のタッチで前のゲートをぬけられる"
    },
    {
      "title": "後ろから鬼が来る3人パス",
      "players": "出し手1人・受け手1人・鬼1人",
      "area": "15m×10m",
      "rule": "受け手の後ろから鬼が近づく。ひらいて受けて前を向けたら1点、後ろへもどしたら0点。",
      "success": "5回中3回、前を向いてから次のパスを出せる",
      "note": "見ること(A4)ができていても、体がボールの方を向いたままだと前を向けない"
    }
  ],
