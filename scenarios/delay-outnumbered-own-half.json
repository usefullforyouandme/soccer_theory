{
  "schemaVersion": 2,
  "id": "delay-outnumbered-own-half",
  "title": "数で負けている時はおくらせる",
  "questionTitle": "1人で2人を守る時は?",
  "category": "defend",
  "group": "delay-outnumbered",
  "keyword": "protect",
  "courseOrder": 9,
  "pattern": "ゴール近くで取られた時",
  "theme": "数的不利(1対2)の時は飛びこまず、2人の間・ゴールとボールの間に立って時間をかせぎ、味方のもどりを待つ",
  "coachNote": "自陣ゴールに近い所でボールを失った場面。相手陣で失った時(D1「取られたらすぐ取り返す」)は「すぐ取り返しに行く」が、ゴールに近い所では、飛びこんでかわされると一気に失点の危機になる。取られた直後は味方がもどりきっておらず、近くは「1人で2人」(相手6・9)の状態。取られた6はゴールとボールの間に立って相手の前進をおくらせ、その間に味方がもどってパスコースを消せば、横パスをカットできる。bad は6が飛びこんでかわされ、ゴール前まで運ばれる例。",
  "coachCue": "ゴールの近くは、飛びこまずにおくらせろ!",
  "drills": [
    {
      "title": "1対2のおくらせゲーム",
      "players": "攻撃2人・守備1人(+もどる守備1人)",
      "area": "幅15m×長さ25m とゴール",
      "rule": "守備は飛びこまずに下がりながら2人を前に見る。5秒たつと、味方の守備がもう1人入る。",
      "success": "5秒シュートを打たせなければ守備の勝ち"
    },
    {
      "title": "もどる人とのはさみ",
      "players": "攻撃2人・守備2人",
      "area": "幅15m×長さ25m",
      "rule": "1人目はおくらせ役、2人目は遠くからもどる役。もどる人が着いたら「着いた!」と声をかけ、2人ではさんで取る。",
      "success": "声をかけてから取りに行けた回数が半分をこえる"
    }
  ],
  "targetGrade": "middle",
  "question": "自分のゴールの近くで{h6}が取られた!{h6}はどうすればいいかな?",
  "keyPoint": "ゴールの近くで取られたら、飛びこまずに前に立って、時間をかせごう!",
