  "schemaVersion": 2,
  "id": "two-v-one-wing",
  "title": "2対1は引きつけてからパス",
  "questionTitle": "2人対1人!いつパスを出す?",
  "category": "attack",
  "group": "two-v-one",
  "keyword": "goal",
  "courseOrder": 5,
  "pattern": "サイドで",
  "theme": "数的優位(2対1)では、ボール保持者が守備者に向かって運び、守備者を自分に引きつけてから空いた味方へパスする",
  "coachNote": "相手陣左サイドで、LM(7)とFW(9)に対し相手RB(3)が1人の場面。7が相手3に向かってドリブルすると、3は7を止めに来るしかなく、9がフリーになる。そこでパスを出せば9はゴールに向かってシュートできる。bad は7が遠くからすぐ9へパスを出してしまい、3がそのまま9へ寄せられる例(2対1が1対1になる)。B5(ドリブルか、パスか)のミスは「続けすぎ」、こちらのミスは「早すぎ」で、2つをセットで見せると「相手が来たら出す」という合図が伝わる。",
  "coachCue": "相手に向かって運べ!来たら出せ!",
  "drills": [
    {
      "title": "2対1のライン突破",
      "players": "攻撃2人・守備1人",
      "area": "幅15m×長さ20m",
      "rule": "ボール保持者は守備者に向かって運び、守備者が自分に来たらパス、来なければそのまま運んでラインを突破する。",
      "success": "5回中3回ラインをこえられる"
    },
    {
      "title": "パスの合図を決める",
      "players": "攻撃2人・守備1人",
      "area": "幅15m×長さ20m",
      "rule": "守備者が「自分の方へ一歩出た」瞬間をパスの合図にする。早すぎるパス・おそすぎるパスのどちらも、コーチが止めて場所を確かめる。",
      "success": "合図の一歩でパスを出せた回数が半分をこえる"
    }
  ],
  "targetGrade": "middle",
