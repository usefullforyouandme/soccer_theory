{
  "schemaVersion": 2,
  "id": "fk-defense-front",
  "title": "相手のフリーキックの守り",
  "questionTitle": "相手のフリーキック!どう守る?",
  "category": "restart",
  "group": "fk-defense",
  "keyword": "protect",
  "courseOrder": 41,
  "pattern": "ゴール正面から",
  "theme": "相手のフリーキックでは、かべの人だけでなく、かべの横やゴール前の相手にもつく。ファウルの後はすぐにもどって、近くの相手につく",
  "coachNote": "自陣ゴールの正面、約20mでの相手フリーキック。FW(9)とCM(6)の2人がかべになる。相手RM(8)がかべの横へ動いて短いパスを受けようとするので、LM(7)がいっしょについていく。横へのパスができないので、相手はそのままけってかべに当たり、6が拾ってつなぐ。bad は7がボールだけを見て8を放し、かべの横へ短いパスを通されて、角度を作られてシュートされる例(E9「味方のフリーキック」の『ゴール正面から』を守る側から見た場面)。かべまでのきょりは大会のルールに合わせる。キーパーはかべで見えない側に立ちすぎないことも合わせて伝える。",
  "coachCue": "かべの横もふさごう!",
  "drills": [
    {
      "title": "かべ+マークの役わり決め",
      "players": "守備5人・攻撃4人+キッカー",
      "area": "ペナルティエリアのまわり",
      "rule": "かべ2人・かべの横の相手につく人・ゴール前でマークする人を、コーチの合図から5秒で決めて立つ。",
      "success": "5秒以内に全員の役わりが決まる"
    },
    {
      "title": "すぐもどってマーク",
      "players": "攻撃3人・守備3人+キッカー",
      "area": "半分のコート",
      "rule": "コーチがファウルの合図をしたら、キッカーはすぐ始めてよい。守備は全員すぐにもどって、近くの相手につく。",
      "success": "すぐ始められても、フリーの相手を作らない"
    }
  ],
  "targetGrade": "middle",
  "question": "ゴールの正面で、相手のフリーキック。かべ以外の人は、どこに立てばいいかな?",
  "keyPoint": "かべの横の相手にも、ついていこう!",
  "ruleNote": "かべのきょりや笛のルールは、大会によってちがうよ",
  "counterpart": {
    "id": "fk-attack-front",
    "label": "せめる側から見る"
