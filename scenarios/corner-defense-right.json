{
  "schemaVersion": 2,
  "id": "corner-defense-right",
  "title": "コーナーキックの守り方",
  "questionTitle": "相手のコーナーキック!どこを守る?",
  "category": "restart",
  "group": "corner-defense",
  "keyword": "protect",
  "courseOrder": 23,
  "pattern": "右からのコーナー",
  "theme": "相手のコーナーキックで、ボールに集まらず、ゴール前の場所(ニア・ファー)と相手に役割を分けて守る",
  "coachNote": "相手の右からのコーナーキック。6はボールが落ちやすいゴール前(ゴールエリアの少し外)の場所を守り、2は外から入ってくる相手8番につく。9は前に残してカウンターにそなえる。4年生のコーナーは20m前後(ゴールエリアの手前)に落ちることが多く、ファーまで届くことは少ない。失点はゴール前・ニアの混戦から生まれやすいので、まずボールが落ちる所を空けないことを優先する(ファーの守りは高学年で)。はね返すのは胸や足で、ヘディングはさせない(育成年代のヘディングのガイドラインに合わせる)。bad は全員がボールばかり見てニアへ集まり、ゴール前で相手8番がフリーになる例。",
  "coachCue": "ボールも相手も、両方見て!",
  "drills": [
    {
      "title": "役割を決めたコーナー守備",
      "players": "守備5人・攻撃4人+キッカー",
      "area": "ペナルティエリア",
      "rule": "ゴール前・ニア・相手のマーク・短いコーナーへのよせ役を決めて守る。1人は前に残す。",
      "success": "5本中4本、ゴール前で先にさわれる"
    },
    {
      "title": "ボールが落ちる所を守る",
      "players": "守備2人・攻撃2人+キッカー",
      "area": "ゴールエリアのまわり",
      "rule": "コーナーからのボールを、ゴール前担当が胸や足で先にさわってはね返す。",
      "success": "落ちる所を空けずに、はね返せる",
      "note": "ヘディングはさせない。4年生のコーナーは20m前後に落ちることが多いので、まずそこを空けない"
    }
  ],
  "targetGrade": "middle",
  "question": "相手のコーナーキック。{h6}と{h2}はどこを守ればいいかな?",
